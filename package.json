    "game": "Nivalis Nights",
    "nexusGameId": 10401
  },
  "devDependencies": {
    "@nexusmods/vortex-api": "2.9.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
